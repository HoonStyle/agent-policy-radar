{
  "targets": [
    {"id": "claude-global", "scope": "global", "path": "~/.claude/CLAUDE.md"},
    {"id": "codex-global", "scope": "global", "path": "~/.codex/AGENTS.md"},
    {"id": "codex-global-override", "scope": "global", "path": "~/.codex/AGENTS.override.md"},
    {
      "id": "pi-global-agents-posix",
      "scope": "global",
      "path": "~/.pi/agent/AGENTS.md"
    },
    {
      "id": "pi-global-agents-windows",
      "scope": "global",
      "path": "%USERPROFILE%/.pi/agent/AGENTS.md"
    },
    {
      "id": "agent-policy-radar-project",
      "scope": "project",
      "path": "./AGENTS.md"
    }
  ],
  "globs": [
    {"scope": "project", "pattern": "~/Documents/*/CLAUDE.md"},
    {"scope": "project", "pattern": "~/Documents/*/AGENTS.md"},
    {"scope": "project", "pattern": "~/Documents/dev/*/CLAUDE.md"},
    {"scope": "project", "pattern": "~/Documents/dev/*/AGENTS.md"},
    {"scope": "skill", "pattern": "~/.claude/skills/*/SKILL.md"},
    {"scope": "skill", "pattern": "~/.codex/skills/*/SKILL.md"},
    {"scope": "skill", "pattern": "~/.claude/plugins/cache/*/*/*/skills/*/SKILL.md"},
    {"scope": "skill", "pattern": "~/.codex/plugins/cache/*/*/*/skills/*/SKILL.md"},
    {
      "scope": "project",
      "pattern": "~/dev/*/AGENTS.md"
    },
    {
      "scope": "project",
      "pattern": "~/dev/*/CLAUDE.md"
    },
    {
      "scope": "project",
      "pattern": "%USERPROFILE%/dev/*/AGENTS.md"
    },
    {
      "scope": "project",
      "pattern": "%USERPROFILE%/dev/*/CLAUDE.md"
    },
    {
      "scope": "project",
      "pattern": "%USERPROFILE%/Documents/dev/*/AGENTS.md"
    },
    {
      "scope": "project",
      "pattern": "%USERPROFILE%/Documents/dev/*/CLAUDE.md"
    },
    {
      "scope": "skill",
      "pattern": "~/.pi/agent/skills/*/SKILL.md"
    },
    {
      "scope": "skill",
      "pattern": "~/.agents/skills/*/SKILL.md"
    },
    {
      "scope": "skill",
      "pattern": "%USERPROFILE%/.pi/agent/skills/*/SKILL.md"
    },
    {
      "scope": "skill",
      "pattern": "%USERPROFILE%/.agents/skills/*/SKILL.md"
    },
    {
      "scope": "telegram-skill",
      "pattern": "~/.pi/agent/npm/node_modules/@llblab/pi-telegram/dist/skills/*/SKILL.md"
    },
    {
      "scope": "telegram-skill",
      "pattern": "%USERPROFILE%/.pi/agent/npm/node_modules/@llblab/pi-telegram/dist/skills/*/SKILL.md"
    },
    {
      "scope": "mcp",
      "pattern": "~/.config/*mcp*/*"
    },
    {
      "scope": "mcp",
      "pattern": "~/.claude*/*mcp*"
    },
    {
      "scope": "mcp",
      "pattern": "%APPDATA%/*mcp*/*"
    },
    {
      "scope": "mcp",
      "pattern": "%USERPROFILE%/.claude*/*mcp*"
    }
  ]
}
